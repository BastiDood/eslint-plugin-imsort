{
  "name": "@bastidood/eslint-plugin-imsort",
  "description": "An opinionated ESLint plugin for sorting imports.",
  "version": "0.11.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": "./dist/index.js",
  "imports": {
    "#*": "./src/*"
  },
  "packageManager": "pnpm@10.30.2+sha512.36cdc707e7b7940a988c9c1ecf88d084f8514b5c3f085f53a2e244c2921d3b2545bc20dd4ebe1fc245feec463bb298aecea7a63ed1f7680b877dc6379d8d0cb4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BastiDood/eslint-plugin-imsort.git"
  },
  "bugs": "https://github.com/BastiDood/eslint-plugin-imsort/issues",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "imports",
    "sort",
    "sort-imports"
  ],
  "scripts": {
    "fmt": "prettier . --experimental-cli --check",
    "fmt:fix": "prettier . --experimental-cli --write",
    "lint": "eslint --cache --concurrency auto",
    "lint:fix": "eslint --cache --concurrency auto --fix",
    "check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "build": "tsup"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/eslint": "^9.6.1",
    "@types/estree": "^1.0.8",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-vitest-rule-tester": "^3.1.0",
    "prettier": "^3.8.1",
    "svelte": "^5.53.3",
    "svelte-eslint-parser": "^1.5.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "itertools": "^2.5.0"
  }
}
